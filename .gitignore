# Swift / Xcode
.build/
.swiftpm/
DerivedData/
*.o
*.d
xcuserdata/
*.xcworkspace/xcuserdata/
*.moved-aside
*.xccheckout

# macOS
.DS_Store
.AppleDouble
.LSOverride

# Env / secrets - never commit
.env
.env.*
*.key
*.pem
